{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "nefconc",
          "sidecar": true,
          "args": [
            "--remove-device-node",
            "--hardware-id",
            "Root\\VirtualDisplayDriver",
            "--class-guid",
            "4D36E968-E325-11CE-BFC1-08002BE10318"
          ]
        },
        {
          "name": "nefconc",
          "sidecar": true,
          "args": [
            "--create-device-node",
            "--class-name",
            "Display",
            "--class-guid",
            "4D36E968-E325-11CE-BFC1-08002BE10318",
            "--hardware-id",
            "Root\\VirtualDisplayDriver"
          ]
        },
        {
          "name": "nefconc",
          "sidecar": true,
          "args": [
            { "validator": "--(install|uninstall)-driver" },
            "--inf-path",
            { "validator": ".*VirtualDisplayDriver\\.inf$" }
          ]
        },
        {
          "name": "certutil",
          "cmd": "certutil",
          "sidecar": false,
          "args": [
            "-addstore",
            "-f",
            { "validator": "root|TrustedPublisher" },
            { "validator": ".*ScreenExtend\\.cer$" }
          ]
        },
        {
          "name": "certutil",
          "cmd": "certutil",
          "sidecar": false,
          "args": [
            "-delstore",
            { "validator": "root|TrustedPublisher" },
            "ScreenExtend"
          ]
        },
        {
          "name": "screenextend",
          "cmd": "screenextend",
          "sidecar": false,
          "args": [
            { "validator": "hostednetwork|installdrivers|removedrivers" },
            { "validator": ".*" },
            { "validator": ".*" }
          ]
        },
        {
          "name": "netsh",
          "cmd": "netsh",
          "sidecar": false,
          "args": [
            "wlan",
            { "validator": "set|start|stop|show" },
            { "validator": "hostednetwork|drivers" },
            { "validator": "mode=allow|.*" },
            { "validator": "ssid=.*" },
            { "validator": "key=.*" }
          ]
        },
        {
          "name": "netsh",
          "cmd": "netsh",
          "sidecar": false,
          "args": [
            "wlan",
            { "validator": "set|start|stop|show" },
            { "validator": "hostednetwork|drivers" }
          ]
        },
        {
          "name": "control",
          "cmd": "control",
          "sidecar": false,
          "args": ["desk.cpl"]
        },
        {
          "name": "open",
          "cmd": "open",
          "sidecar": false,
          "args": ["x-apple.systempreferences:com.apple.preference.displays"]
        }
      ]
    },
    "shell:allow-open",
    "clipboard-manager:allow-write-text",
    "core:window:allow-destroy",
    "core:webview:allow-set-webview-zoom",
    "store:default",
    "os:default",
    "dialog:default",
    "notification:default"
  ]
}
