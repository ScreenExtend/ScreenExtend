{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenExtend",
  "mainBinaryName": "ScreenExtend",
  "version": "0.3.8",
  "identifier": "app.screenextend.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/VirtualDisplayDriver.dll",
      "resources/VirtualDisplayDriver.cat",
      "resources/VirtualDisplayDriver.inf",
      "resources/ScreenExtend.cer",
      "resources/libx264-164.dll"
    ],
    "publisher": "Sarvesh Madullapalli",
    "copyright": "Copyright © 2026 Sarvesh Madullapalli All Rights Reserved",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/nefconc"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "cli": {
      "subcommands": {
        "hostednetwork": {
          "args": [
            {
              "name": "ssid",
              "index": 1,
              "takesValue": true
            },
            {
              "name": "password",
              "index": 2,
              "takesValue": true
            }
          ]
        },
        "installdrivers": {
          "args": []
        },
        "removedrivers": {
          "args": []
        }
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwRERFOTc1RTNCREU5NDYKUldSRzZiM2pkZW5ka1Bpc2dMSjNVV2FNUU5VRUE0aWZGNzloYTJlWXoyYWsvSC80UVNyYTU5WmYK",
      "endpoints": [
        "https://github.com/ScreenExtend/ScreenExtend/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
